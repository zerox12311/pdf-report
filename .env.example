# 複製成 .env 後修改（docker compose 會自動讀取；.env 已在 .gitignore，不會被 commit）：
#   cp .env.example .env
# 所有值都有本機試用預設，不建 .env 也能直接 docker compose up。
# 對外部署前至少要改：ADMIN_PASSWORD、SESSION_SECRET、POSTGRES_PASSWORD。

# ── 入口 ──
# 服務對外的 port（http://localhost:<APP_PORT>）
APP_PORT=8090

# ── 控制台初始管理員（僅首次啟動、使用者表為空時建立）──
ADMIN_USER=admin
ADMIN_PASSWORD=admin1234

# ── session / embed token 簽章金鑰（必改；洩漏等於可偽造登入與嵌入權限）──
# 產生隨機值：openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# ── 資料庫密碼（app 的連線字串會自動帶入同一個值）──
POSTGRES_PASSWORD=pdftpl

# ── 跨網域白名單（逗號分隔；留空 = 僅同源；* = 全開，僅建議 demo）──
# 宿主前端要跨網域直呼 API（例如匿名渲染）時，填宿主網域：
# CORS_ORIGINS=https://your-app.example.com,https://staging.example.com
CORS_ORIGINS=
